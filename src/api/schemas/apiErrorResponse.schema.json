{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ApiErrorResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_REQUEST",
            "INVALID_INTENT",
            "INVALID_PORTFOLIO_VALUE",
            "DATA_CONSISTENCY_ERROR",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string"
        },
        "details": {}
      }
    }
  }
}

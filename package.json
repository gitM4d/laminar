    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "fastify": "^5.8.5"
  }
